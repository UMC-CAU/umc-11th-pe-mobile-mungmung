{
  "info": {
    "name": "Movie API - capture and requirements",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run 01-15 in order against your local server. Creates two members and one rating, then deletes only the created rating. Member accounts remain. 01 generates fresh email/nickname values and stores response IDs automatically. 02 and 03 are the remaining required screenshots."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "memberId",
      "value": ""
    },
    {
      "key": "otherMemberId",
      "value": ""
    },
    {
      "key": "ratingId",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "nickname",
      "value": ""
    },
    {
      "key": "otherEmail",
      "value": ""
    },
    {
      "key": "otherNickname",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Signup success - capture",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "description": "Expected HTTP 201. Run requests in order.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"nickname\": \"{{nickname}}\",\n  \"password\": \"Strong123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const run = Date.now().toString();",
              "pm.collectionVariables.set(\"email\", \"capture\" + run + \"@example.com\");",
              "pm.collectionVariables.set(\"nickname\", \"u\" + run.slice(-10));",
              "pm.collectionVariables.set(\"otherEmail\", \"other\" + run + \"@example.com\");",
              "pm.collectionVariables.set(\"otherNickname\", \"v\" + run.slice(-10));",
              "pm.collectionVariables.unset(\"memberId\");",
              "pm.collectionVariables.unset(\"otherMemberId\");",
              "pm.collectionVariables.unset(\"ratingId\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test(\"Common response envelope\", () => {",
              "  pm.expect(body).to.have.all.keys(\"isSuccess\", \"code\", \"message\", \"result\");",
              "  pm.expect(body.isSuccess).to.eql(true);",
              "  pm.expect(body.code).to.eql(\"COMMON201\");",
              "});",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"memberId\", body.result.memberId);",
              "pm.test(\"Password excluded\", () => pm.expect(body.result).not.to.have.property(\"password\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Signup invalid email - capture",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "description": "Expected HTTP 400. Run requests in order.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"invalid-email\",\n  \"nickname\": \"{{nickname}}\",\n  \"password\": \"Strong123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "const body = pm.response.json();",
              "pm.test(\"Common response envelope\", () => {",
              "  pm.expect(body).to.have.all.keys(\"isSuccess\", \"code\", \"message\", \"result\");",
              "  pm.expect(body.isSuccess).to.eql(false);",
              "  pm.expect(body.code).to.eql(\"COMMON400\");",
              "});",
              "pm.test(\"Null error result\", () => pm.expect(body.result).to.eql(null));"
            ]
          }
        }
      ]
    },
